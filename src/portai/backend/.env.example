# portai backend environment variables
# Copy to .env (same directory as this file) and fill in real values.
# The .env file is gitignored — never commit it.

# ── Anthropic API ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=enter-your-key-here

# ── App ───────────────────────────────────────────────────────────────────────
APP_PORT=8000
APP_ENV=development
